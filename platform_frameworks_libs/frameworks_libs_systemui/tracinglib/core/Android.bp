package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

java_library {
    name: "tracinglib-platform",
    static_libs: [
        "kotlinx_coroutines_android",
        "com_android_systemui_flags_lib",
        "compilelib",
    ],
    kotlincflags: [
        "-jvm-default=no-compatibility",
        "-Xexplicit-api=strict",
    ],
    srcs: ["src/**/*.kt"],
}
