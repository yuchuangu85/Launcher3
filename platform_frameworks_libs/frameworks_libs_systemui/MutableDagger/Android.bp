package {
    default_visibility: [
        "//visibility:public",
    ],
}

java_library {
    name: "mutable-dagger-annotations",
    srcs: [
        "src_annotations/**/*.java",
        "src_annotations/**/*.kt",
    ],
    static_libs: [
        "kotlin-reflect",
    ],
    host_supported: true,
}

java_plugin {
    name: "mutable-dagger-compiler",
    srcs: [
        "src_processor/**/*.java",
        "src_processor/**/*.kt",
    ],
    static_libs: [
        "mutable-dagger-annotations",
        "dagger2",
        "kotlin_symbol_processing_api",
        "jsr330",
    ],
    java_resource_dirs: ["resources"],
    generates_api: true,
}
