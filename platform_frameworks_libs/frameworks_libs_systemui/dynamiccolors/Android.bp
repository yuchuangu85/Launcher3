package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// Standard library with light and dark color resources.
android_library {
    name: "dynamiccolors",
    sdk_version: "current",
    min_sdk_version: "30",
    resource_dirs: ["res"],
    apex_available: [
        "//apex_available:platform",
        "com.android.mediaprovider",
        "com.android.nfcservices",
    ],
    lint: {
        baseline_filename: "lint-baseline.xml",
    },
}
