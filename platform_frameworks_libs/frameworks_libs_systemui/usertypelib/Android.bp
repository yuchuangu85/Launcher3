package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_library {
    name: "usertypelib",
    sdk_version: "current",
    min_sdk_version: "31",
    srcs: [
        "src/**/*.java",
        "src/**/*.kt",
    ],
    static_libs: [
        "kotlin-parcelize-runtime",
    ],
    kotlin_plugins: ["kotlin-parcelize-compiler-plugin"],
    kotlincflags: ["-Xjvm-default=all"],
}
