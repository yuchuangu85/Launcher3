<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:androidprv="http://schemas.android.com/apk/prv/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/taskbar_edu_title"
        style="@style/TextAppearance.TaskbarEduTooltip.Title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/taskbar_edu_tooltip_vertical_margin"
        tools:text="@string/taskbar_edu_features"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tooltip_0_animation"/>

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/tooltip_0_animation"
        android:layout_width="@dimen/taskbar_edu_features_lottie_width"
        android:layout_height="@dimen/taskbar_edu_features_lottie_height"
        app:layout_constraintEnd_toEndOf="@id/tooltip_0_description"
        app:layout_constraintStart_toStartOf="@id/tooltip_0_description"
        app:layout_constraintTop_toBottomOf="@id/taskbar_edu_title"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        tools:lottie_rawRes="@raw/taskbar_edu_splitscreen_transient" />

    <TextView
        android:id="@+id/tooltip_0_description"
        style="@style/TextAppearance.TaskbarEduTooltip.Subtext"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@id/tooltip_1_description"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tooltip_0_animation"
        tools:text="@string/taskbar_edu_splitscreen" />

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/tooltip_1_animation"
        android:layout_width="@dimen/taskbar_edu_features_lottie_width"
        android:layout_height="@dimen/taskbar_edu_features_lottie_height"
        app:layout_constraintEnd_toEndOf="@id/tooltip_1_description"
        app:layout_constraintStart_toStartOf="@id/tooltip_1_description"
        app:layout_constraintTop_toBottomOf="@id/taskbar_edu_title"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        tools:lottie_rawRes="@raw/taskbar_edu_bubbles_transient"/>

    <TextView
        android:id="@+id/tooltip_1_description"
        style="@style/TextAppearance.TaskbarEduTooltip.Subtext"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/taskbar_edu_features_horizontal_spacing"
        app:layout_constraintEnd_toStartOf="@id/tooltip_2_description"
        app:layout_constraintStart_toEndOf="@id/tooltip_0_description"
        app:layout_constraintTop_toBottomOf="@id/tooltip_1_animation"
        tools:text="@string/taskbar_edu_bubbles" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/tooltip_2_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tooltip_2_animation,tooltip_2_description" />

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/tooltip_2_animation"
        android:layout_width="@dimen/taskbar_edu_features_lottie_width"
        android:layout_height="@dimen/taskbar_edu_features_lottie_height"
        app:layout_constraintEnd_toEndOf="@id/tooltip_2_description"
        app:layout_constraintStart_toStartOf="@id/tooltip_2_description"
        app:layout_constraintTop_toBottomOf="@id/taskbar_edu_title"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        tools:lottie_rawRes="@raw/taskbar_edu_pinning_transient" />

    <TextView
        android:id="@+id/tooltip_2_description"
        style="@style/TextAppearance.TaskbarEduTooltip.Subtext"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/taskbar_edu_features_horizontal_spacing"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/tooltip_1_description"
        app:layout_constraintTop_toBottomOf="@id/tooltip_2_animation"
        tools:text="@string/taskbar_edu_pinning" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/edu_barrier_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="tooltip_0_description,tooltip_1_description,tooltip_2_description" />

    <Button
        android:id="@+id/action_button"
        style="@style/TaskbarEdu.Button.Done"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:paddingVertical="12dp"
        tools:text="@string/taskbar_edu_done"
        android:textColor="?androidprv:attr/textColorOnAccent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edu_barrier_bottom" />

</androidx.constraintlayout.widget.ConstraintLayout>