package: "com.android.launcher3"
container: "system_ext"

flag {
    name: "enable_later_is_locked_check"
    namespace: "launcher_overview"
    description: "Checks if users associated with tasks are locked later in the data flow to prevent stale data"
    bug:  "417220811"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "enable_overview_desktop_tile_wallpaper_background"
    namespace: "launcher_overview"
    description: "Enable wallpaper background for desktop tasks in overview."
    bug: "363257721"
}

flag {
    name: "enable_refactor_digital_wellbeing_toast"
    namespace: "launcher_overview"
    description: "Enables rewritten version of digital wellbeing toast in overview."
    bug: "404838605"
}

flag {
    name: "enable_simultaneous_overview_trigger_on_extended_desktop"
    namespace: "launcher_overview"
    description: "Enable Overview to launch and exit simultaneously on default and external displays wherever it was triggered or quit from"
    bug:  "421128035"
}

flag {
    name: "enable_predictive_back_in_overview"
    namespace: "launcher_overview"
    description: "Enables predictive back animation in Overview on back navigation"
    bug: "421292121"
}

flag {
    name: "enable_overview_pagination"
    namespace: "launcher_overview"
    description: "Allows the user to scroll overview with a mouse click."
    bug: "443252794"
}

flag {
    name: "hide_automated_tasks_in_overview"
    namespace: "launcher_overview"
    description: "Hide a task from overview if it is being automated."
    bug:  "440355882"
}

flag {
    name: "enable_low_res_thumbnail_preloading"
    namespace: "launcher_overview"
    description: "Enables usage of low resolution thumbnails in preloading to save memory."
    bug: "446013310"
}

flag {
    name: "enable_tasks_drag_and_drop_in_overview"
    namespace: "launcher_overview"
    description: "Allows the user to drag and drop tasks between desktops in overview."
    bug: "434939081"
}

flag {
    name: "enable_overview_select_text_view"
    namespace: "launcher_overview"
    description: "Creates views for selected texts to enable accessible traversal."
    bug: "447292419"
}

flag {
    name: "update_recents_wm_wwm_configuration"
    namespace: "launcher_overview"
    description: "Bugfix for missing configurations in RWM"
    bug: "448688934"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "enable_recents_window_blur"
    namespace: "launcher_overview"
    description: "Enable wallpaper blur for RecentsWindowManager"
    bug: "402685067"
}

flag {
    name: "enable_save_action_in_overview_share"
    namespace: "launcher_overview"
    description: "Bugfix for missing Save action in Overview Share Sheet"
    bug: "493115665"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}
