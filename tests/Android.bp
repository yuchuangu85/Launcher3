package {
    // See: http://go/android-license-faq
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_launcher",
}

// Source code used for test
filegroup {
    name: "launcher-tests-src",
    srcs: [
        "src/**/*.java",
        "src/**/*.kt",
        "multivalentTests/src/**/*.java",
        "multivalentTests/src/**/*.kt",
        ":launcher-e2e-inproc-tests",
    ],
    exclude_srcs: [
        ":launcher-non-quickstep-tests-src",
    ],
}

filegroup {
    name: "launcher3-robo-src",
    // multivalentTests directory is a shared folder for not only robolectric converted test
    // classes but also shared helper classes.
    srcs: [
        "multivalentTests/src/**/*.java",
        "multivalentTests/src/**/*.kt",
        "src_deviceless/**/*.java",
        "src_deviceless/**/*.kt",
    ],
}

// Source code used for non-quickstep tests
filegroup {
    name: "launcher-non-quickstep-tests-src",
    srcs: [
        "src/com/android/launcher3/nonquickstep/**/*.java",
        "src/com/android/launcher3/nonquickstep/**/*.kt",
    ],
}

// Source code used for oop test helpers
filegroup {
    name: "launcher-oop-tests-src",
    srcs: [
        ":launcher-testing-helpers",
        ":launcher-oop-tests-only",
    ],
}

// Library with all the dependencies for building quickstep
android_library {
    name: "Launcher3TestLib",
    srcs: [],
    static_libs: [
        "flag-junit-base",
        "launcher-aosp-tapl",
        "androidx.test.core",
        "androidx.test.runner",
        "androidx.test.rules",
        "androidx.test.ext.junit",
        "androidx.test.espresso.core",
        "androidx.test.espresso.contrib",
        "androidx.test.espresso.intents",
        "androidx.test.uiautomator_uiautomator",
        "mockito-kotlin2",
        "mockito-target-extended-minus-junit4",
        "mutable-dagger-annotations",
        "launcher_log_protos_lite",
        "truth",
        "kotlinx_coroutines_test",
        "platform-test-rules",
        "testables",
        "com_android_launcher3_flags_lib",
        "com_android_wm_shell_flags_lib",
        "com_android_systemui_shared_flags_lib",
        "android.appwidget.flags-aconfig-java",
        "platform-parametric-runner-lib",
        "kotlin-reflect",
        "kotlin-test",
        "systemui-helper",
        "systemui-tapl",
        "Launcher3TestResources",
        "android.security.flags-aconfig-java",
    ],
    package_name: "com.android.launcher3.tests",
    platform_apis: true,
}

android_library {
    name: "Launcher3TestResources",
    resource_dirs: ["res"],
    asset_dirs: ["assets"],
    // TODO(b/319712088): re-enable use_resource_processor
    use_resource_processor: false,
    static_libs: [
        "kotlin-reflect",
    ],
    manifest: "AndroidManifest-common.xml",
}

android_test {
    name: "Launcher3Tests",
    srcs: [
        ":launcher-tests-src",
        ":launcher-non-quickstep-tests-src",
        ":launcher-tests-shared-utils",
    ],
    exclude_srcs: [
        // Launcher3 tests setup has an issue with resolving a few resources within transitive
        // compose dependencies that work fine in actual Launcher3 app.
        "src_e2e/com/android/launcher3/widget/TaplAddWidgetTest.java",
    ],
    static_libs: [
        "Launcher3TestLib",
        "com_android_launcher3_flags_lib",
        "com_android_systemui_shared_flags_lib",
        "shark-android",
    ],
    libs: [
        "android.test.base.stubs.system",
        "android.test.runner.stubs.system",
        "android.test.mock.stubs.system",
    ],
    // Libraries used by mockito inline extended
    jni_libs: [
        "libdexmakerjvmtiagent",
        "libstaticjvmtiagent",
    ],
    use_embedded_native_libs: false,
    compile_multilib: "both",
    instrumentation_for: "Launcher3",
    manifest: "AndroidManifest.xml",
    platform_apis: true,
    test_config: "Launcher3Tests.xml",
    data: [":Launcher3"],
    enable_ksp: true,
    plugins: [
        "mutable-dagger-compiler",
        "dagger2-compiler",
    ],
    test_suites: ["general-tests"],
    lint: {
        baseline_filename: "lint-baseline.xml",
    },
    kotlincflags: [
        "-Xallow-no-source-files",
        "-Xemit-jvm-type-parameters",
    ],
}

filegroup {
    name: "launcher-testing-helpers-robo",
    srcs: [
        "src/**/*.java",
        "src/**/*.kt",
        "multivalentTests/src/**/*.java",
        "multivalentTests/src/**/*.kt",
        "src/com/android/launcher3/util/ui/AbstractLauncherUiTest.java",
        "src/com/android/launcher3/util/ui/BaseLauncherTaplTest.java",
        "tapl/com/android/launcher3/tapl/*.java",
        "tapl/com/android/launcher3/tapl/*.kt",
    ],
    exclude_srcs: [
        // Test classes
        "src/**/*Test.java",
        "src/**/*Test.kt",
        "src/**/RoboApiWrapper.kt",
        "src/**/EventsRule.kt",
        "src/**/LauncherCustomizer.kt",
        "multivalentTests/src/**/*Test.java",
        "multivalentTests/src/**/*Test.kt",
    ],
}

filegroup {
    name: "launcher-testing-helpers",
    srcs: [
        ":launcher-testing-helpers-robo",
        "src/**/RoboApiWrapper.kt",
    ],
}
